    {
      "name": "Étudiants",
      "description": "CRUD des étudiants de la bibliothèque (/api/students). Toutes ces routes exigent un Bearer token valide. Le pre-request script du dossier se reconnecte avec {{uniqueLogin}}/{{user_password}} avant CHAQUE requête pour obtenir un token frais (jamais mis en cache, donc jamais expiré) — l'utilisateur correspondant doit déjà exister (l'exécuter après « Inscription — succès », ou renseigner un compte existant dans les variables d'environnement).",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.environment.get('baseUrl');",
              "const login = pm.environment.get('uniqueLogin');",
              "const password = pm.environment.get('user_password');",
              "",
              "pm.sendRequest({",
              "    url: baseUrl + '/api/login',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: {",
              "        mode: 'raw',",
              "        raw: JSON.stringify({ login, password })",
              "    }",
              "}, function (loginError, loginResponse) {",
              "    pm.collectionVariables.set('authToken', loginResponse.json().token);",
              "});"
            ]
          }
        }
      ],

# Stop Lombok-generated boilerplate (equals/hashCode/toString/builder/getters/setters)
# from skewing JaCoCo's instruction-coverage numbers: tagging that bytecode with
# @lombok.Generated lets JaCoCo's built-in "Generated" filter exclude it automatically
# (JaCoCo excludes any method carrying an annotation simply named "Generated").
lombok.addLombokGeneratedAnnotation = true
